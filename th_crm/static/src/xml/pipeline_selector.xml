<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="th_crm.PipelineSelector" owl="1">
        <div class="o_pipeline_selector">
            <select class="o_pipeline_select form-control" t-on-change="onPipelineChange">
                <option value="">All Pipelines</option>
                <option t-foreach="state.pipelines" t-as="pipeline" t-key="pipeline.id" t-att-value="pipeline.id" t-att-selected="state.selectedPipelineId === pipeline.id">
                    <t t-esc="pipeline.name"/>
                </option>
            </select>
        </div>
    </t>
</templates>
