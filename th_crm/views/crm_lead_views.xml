<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- CRM Lead Form View Inheritance -->
        <record id="view_crm_lead_form_inherit" model="ir.ui.view">
            <field name="name">crm.lead.form.inherit</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_form"/>
            <field name="arch" type="xml">
                <!-- Add Second Currency fields in h2 with labels before existing h2 -->
                <xpath expr="//h2" position="before">
                    <h2 class="row g-0 pb-3 pb-sm-4">
                        <div class="col-3 pb-2 pb-md-0">
                            <label class="o_form_label oe_edit_only" for="currency_id">Currency</label>
                            <div class="d-flex flex-wrap align-items-baseline">
                                <field name="currency_id" class="oe_inline"/>
                            </div>
                        </div>
                        <div class="col-4 pb-2 pb-md-0">
                            <label class="o_form_label oe_edit_only" for="planned_revenue_second">Revenue Other Currency</label>
                            <div class="d-flex flex-wrap align-items-baseline">
                                <field name="planned_revenue_second" class="oe_inline o_input_13ch"/>
                            </div>
                        </div>
                        <div class="col-5 pb-2 pb-md-0">
                            <label class="o_form_label oe_edit_only" for="value">Value</label>
                            <div class="d-flex flex-wrap align-items-baseline">
                                <field name="value" class="oe_inline o_input_13ch"/>
                            </div>
                        </div>
                    </h2>
                </xpath>
                <!-- Add fields -->
                <xpath expr="//form/sheet/group" position="after">
                    <group string="Qualification / Opportunity">
                        <group>
                            <field name="dr_no"/>
                            <field name="sequence_enrollment"/>
                            <field name="hyperscaler"/>
                            <field name="technology"/>
                        </group>
                        <group>
                            <field name="second_contact_person_id"/>
                            <field name="informatica_solution_id"/>
                            <field name="selection_criterias"/>
                        </group>
                    </group>
                    <group string="Commercial / Business">
                        <group>
                            <field name="gcp_billing_account"/>
                            <field name="ps_opp_exist"/>
                            <field name="year_of_commit"/>
                        </group>
                        <group>
                            <field name="vendor_subscription_start_date"/>
                            <field name="training_opp_exist"/>
                        </group>
                    </group>
                    <group string="Competition">
                        <group>
                            <field name="service_competitor_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="tech_competitor_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group string="Qualification Details">
                        <group>
                            <field name="authority"/>
                            <field name="lead_source_details"/>
                        </group>
                        <group>
                            <field name="budget"/>
                            <field name="risk"/>
                            <field name="timing"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>
        <!-- CRM Lead Kanban View Inheritance -->
        <record id="view_crm_lead_kanban_inherit" model="ir.ui.view">
            <field name="name">crm.lead.kanban.inherit</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
            <field name="arch" type="xml">
                <!-- Add Second Currency fields to kanban view -->
                <xpath expr="/kanban//field[@name='name']" position="after">
                    <field name="planned_revenue_second"/>
                    <field name="value"/>
                    <field name="currency_id"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
