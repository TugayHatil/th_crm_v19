<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Informatica Solution Tree View -->
        <record id="view_th_crm_informatica_solution_tree" model="ir.ui.view">
            <field name="name">th.crm.informatica.solution.tree</field>
            <field name="model">th.crm.informatica.solution</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                </tree>
            </field>
        </record>

        <!-- Informatica Solution Form View -->
        <record id="view_th_crm_informatica_solution_form" model="ir.ui.view">
            <field name="name">th.crm.informatica.solution.form</field>
            <field name="model">th.crm.informatica.solution</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Informatica Solution Action -->
        <record id="action_th_crm_informatica_solution" model="ir.actions.act_window">
            <field name="name">Informatica Solutions</field>
            <field name="res_model">th.crm.informatica.solution</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Informatica Solution Menu - Disabled for testing -->
        <!-- <menuitem id="menu_th_crm_informatica_solution" 
                  name="Informatica Solutions" 
                  parent="crm.menu_crm_config_lead"
                  action="action_th_crm_informatica_solution"
                  sequence="10"/> -->
    </data>
</odoo>
