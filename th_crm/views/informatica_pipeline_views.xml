<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Informatica Pipeline List View -->
        <record id="view_informatica_pipeline_tree" model="ir.ui.view">
            <field name="name">informatica.pipeline.tree</field>
            <field name="model">informatica.pipeline</field>
            <field name="arch" type="xml">
                <list string="Informatica Pipelines">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <!-- Informatica Pipeline Form View -->
        <record id="view_informatica_pipeline_form" model="ir.ui.view">
            <field name="name">informatica.pipeline.form</field>
            <field name="model">informatica.pipeline</field>
            <field name="arch" type="xml">
                <form string="Informatica Pipeline">
                    <sheet>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Informatica Pipeline Action -->
        <record id="action_informatica_pipeline" model="ir.actions.act_window">
            <field name="name">Informatica Pipelines</field>
            <field name="res_model">informatica.pipeline</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first Informatica Pipeline!
                </p>
            </field>
        </record>

        <!-- Informatica Pipeline Menu Item -->
        <menuitem id="menu_informatica_pipeline"
                  name="Informatica Pipelines"
                  parent="crm.menu_crm_config_lead"
                  action="action_informatica_pipeline"
                  sequence="11"/>
    </data>
</odoo>
