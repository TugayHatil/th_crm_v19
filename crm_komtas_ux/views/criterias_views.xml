<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Criterias List View -->
        <record id="view_criterias_tree" model="ir.ui.view">
            <field name="name">criterias.tree</field>
            <field name="model">criterias</field>
            <field name="arch" type="xml">
                <list string="Selection Criterias">
                    <field name="name"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <!-- Criterias Form View -->
        <record id="view_criterias_form" model="ir.ui.view">
            <field name="name">criterias.form</field>
            <field name="model">criterias</field>
            <field name="arch" type="xml">
                <form string="Selection Criteria">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Criterias Action -->
        <record id="action_criterias" model="ir.actions.act_window">
            <field name="name">Selection Criterias</field>
            <field name="res_model">criterias</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first Selection Criteria!
                </p>
            </field>
        </record>

        <!-- Criterias Menu Item — config altında Pipeline menüsünün hemen altında -->
        <menuitem id="menu_criterias"
                  name="Selection Criterias"
                  parent="crm.menu_crm_config_lead"
                  action="action_criterias"
                  sequence="13"/>
    </data>
</odoo>
