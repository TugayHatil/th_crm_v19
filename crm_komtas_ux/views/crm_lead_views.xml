<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- CRM Lead Form View Inheritance -->
        <record id="view_crm_lead_form_inherit" model="ir.ui.view">
            <field name="name">crm.lead.form.inherit</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_form"/>
            <field name="arch" type="xml">
                <!-- Add deal-currency fields before the expected revenue block -->
                <xpath expr="//div[hasclass('oe_title')]/h2" position="before">
                    <h2 class="row g-0 pb-3 pb-sm-4">
                        <div class="col-12 col-md-2 pb-2 pb-md-0">
                            <label class="o_form_label oe_edit_only text-nowrap" for="currency_id">Deal Currency</label>
                            <div class="d-flex flex-wrap align-items-baseline">
                                <field name="currency_id" class="oe_inline"/>
                            </div>
                        </div>
                        <div class="col-12 col-md-3 pb-2 pb-md-0">
                            <label class="o_form_label oe_edit_only text-nowrap" for="planned_revenue_second">Revenue Other Currency</label>
                            <div class="d-flex flex-wrap align-items-baseline">
                                <field name="planned_revenue_second" class="oe_inline o_input_13ch"/>
                            </div>
                        </div>
                        <div class="col-12 col-md-3 pb-2 pb-md-0">
                            <label class="o_form_label oe_edit_only text-nowrap" for="prorated_revenue_second">Prorated Revenue</label>
                            <div class="d-flex flex-wrap align-items-baseline">
                                <field name="prorated_revenue_second" class="oe_inline o_input_13ch fw-normal"/>
                            </div>
                        </div>
                        <div class="col-12 col-md-4 pb-2 pb-md-0">
                            <label class="o_form_label oe_edit_only text-nowrap" for="pipeline_id">Pipeline</label>
                            <div class="d-flex flex-wrap align-items-baseline">
                                <field name="pipeline_id" class="oe_inline" options="{'no_create': True}"/>
                            </div>
                        </div>
                    </h2>
                </xpath>
                <!-- Override stage_id field domain only, keep original widget -->
                <xpath expr="//field[@name='stage_id']" position="attributes">
                    <attribute name="domain">['|', ('pipeline_ids', '=', False), ('pipeline_ids', '=', pipeline_id)]</attribute>
                </xpath>
                <!-- Add qualification / opportunity fields just before the notebook -->
                <xpath expr="//notebook" position="before">
                    <group string="Qualification / Opportunity">
                        <group>
                            <field name="dr_no"/>
                            <field name="sequence_enrollment"/>
                            <field name="hyperscaler_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="technology"/>
                        </group>
                        <group>
                            <field name="second_contact_person_id"/>
                            <field name="informatica_solution_id" options="{'no_create': True}"/>
                            <field name="selection_criterias_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group string="Commercial / Business">
                        <group>
                            <field name="gcp_billing_account"/>
                            <field name="ps_opp_exist"/>
                            <field name="year_of_commit"/>
                        </group>
                        <group>
                            <field name="vendor_subscription_start_date"/>
                            <field name="training_opp_exist"/>
                        </group>
                    </group>
                    <group string="Competition">
                        <group>
                            <field name="service_competitor_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                        <group>
                            <field name="tech_competitor_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                    </group>
                    <group string="Qualification Details">
                        <group>
                            <field name="authority"/>
                            <field name="lead_source_details"/>
                        </group>
                        <group>
                            <field name="budget"/>
                            <field name="risk"/>
                            <field name="timing"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>
        <!-- CRM Lead Kanban View Inheritance -->
        <record id="view_crm_lead_kanban_inherit" model="ir.ui.view">
            <field name="name">crm.lead.kanban.inherit</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
            <field name="arch" type="xml">
                <!-- Show the deal-currency revenue on the kanban card -->
                <xpath expr="//templates/t[@t-name='card']//div[hasclass('o_kanban_card_crm_lead_revenue')]" position="before">
                    <field name="currency_id" invisible="1"/>
                    <div class="o_kanban_card_crm_lead_revenue_second">
                        <t t-if="record.planned_revenue_second.raw_value or record.prorated_revenue_second.raw_value">
                            <t t-if="record.planned_revenue_second.raw_value">
                                <field name="planned_revenue_second" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            </t>
                            <t t-if="record.planned_revenue_second.raw_value and record.prorated_revenue_second.raw_value"> / </t>
                            <t t-if="record.prorated_revenue_second.raw_value">
                                <field name="prorated_revenue_second" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            </t>
                        </t>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
