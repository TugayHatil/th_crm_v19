<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_crm_lead_stage_wizard_form" model="ir.ui.view">
            <field name="name">crm.lead.stage.wizard.form</field>
            <field name="model">crm.lead.stage.wizard</field>
            <field name="arch" type="xml">
                <form string="Aşama Değiştir">
                    <sheet>
                        <group>
                            <field name="lead_id" readonly="1"/>
                            <field name="current_stage_id" readonly="1"/>
                            <field name="target_stage_id"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_confirm" string="Onayla" type="object" class="btn-primary"/>
                        <button string="İptal" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
